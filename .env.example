# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this full-stack application is hosted.
APP_URL="MY_APP_URL"

# Optional comma-separated list of allowed frontend origins when frontend & API are hosted separately
ALLOWED_ORIGINS=""

# Optional frontend API base URL override when frontend is deployed separately from the backend
VITE_API_BASE_URL=""

# Payment Mode: keep "pending" until you are ready to activate live payment gateways ("live")
PAYMENT_MODE="pending"

# Payment Gateways (Server-side secrets — optional while PAYMENT_MODE is "pending")
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Transactional Email & WhatsApp Notifications (Server-side secrets)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Josy Textile <orders@josytextile.com>"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
